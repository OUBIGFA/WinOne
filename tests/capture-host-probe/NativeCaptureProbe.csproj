<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>WinOne.NativeCapture.Probe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF changes the SDK implicit imports; the linked capture probes use IO. -->
    <Using Include="System.IO" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.4258.31]" />
    <ProjectReference Include="../../modules/capture/WinOne.Capture.csproj" />
  </ItemGroup>
  <Target Name="RequireProbeIsolation" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ShareXSourceDirectory)' == ''" Text="Pass an isolated ShareX copy. Do not build against the product dependency checkout." />
  </Target>
</Project>
