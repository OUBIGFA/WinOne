<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WinOne.Ocr</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../capture/Ocr/OcrReadingOrder.cs" Link="OcrReadingOrder.cs" />
    <Compile Include="../capture/Ocr/OcrGapTree.cs" Link="OcrGapTree.cs" />
    <Compile Include="../capture/Ocr/OcrParagraphs.cs" Link="OcrParagraphs.cs" />
    <Compile Include="../capture/Ocr/OcrRecognition.cs" Link="OcrRecognition.cs" />
    <Compile Include="../capture/Ocr/RapidOcrNative.cs" Link="RapidOcrNative.cs" />
    <Compile Include="../capture/Ocr/OcrLayout.cs" Link="OcrLayout.cs" />
  </ItemGroup>
</Project>
