          "newText": "\tgpu  gpuRenderer\n\tpreparing *gpuPreparation\n"
        },
        {
          "oldText": "func (h *windowHost) makeGPU() {\n",
          "newText": "func (h *windowHost) makeGPU() {\n\tif p := h.preparing; p != nil {\n\t\tselect {\n\t\tcase <-p.ready:\n\t\tdefault:\n\t\t\treturn // The complete scene and input continue on the CPU.\n\t\t}\n\t}\n"
