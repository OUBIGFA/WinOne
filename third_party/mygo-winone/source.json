        {
          "oldText": "scroll := ui.ScrollHorizontal(c).AlignSelf(ui.Stretch)",
          "newText": "// WinOne keeps every table cell in the finite reading column.\n\t// Columns share available width and wrap instead of making a hidden\n\t// horizontal viewport; upstream parsing, rows and selection stay intact.\n\tscroll := ui.Column(c).FillWidth().MinWidth(0).AlignSelf(ui.Stretch)"
        },
        {
          "oldText": "grid := ui.Column(c).Border(1, th.TableBorder)",
          "newText": "grid := ui.Column(c).FillWidth().MinWidth(0).Border(1, th.TableBorder)"
        },
        {
          "oldText": "rowEl := ui.Row(c).Role(ui.RoleRow).AlignItems(ui.Stretch)",
          "newText": "rowEl := ui.Row(c).FillWidth().MinWidth(0).Role(ui.RoleRow).AlignItems(ui.Stretch)"
        },
        {
          "oldText": "box := ui.Column(c).Width(widths[k]).Padding(padY, padX).Role(role)",
          "newText": "box := ui.Column(c).Width(widths[k]).MinWidth(0).Shrink(1).Padding(padY, padX).Role(role)"
        }
      ]
    },
    {
