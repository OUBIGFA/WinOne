node_modules/
dist/
bin/
obj/
target/
coverage/
test-results/
playwright-report/
# Vite 依赖预构建缓存，由开发服务器自动生成。
.vite/
.vs/
.idea/
.DS_Store
*.user
*.suo
*.log
*.syso
internal/branding/icon.ico
internal/branding/logo-native.png
.env
.env.*
!.env.example
*.local.ps1
*.local.json
# Wails frontend compilation is regenerated before Go builds.
apps/desktop/frontend/dist/
/apps/result-ui/assets/logo.png
/apps/result-ui/assets/provider-bitmaps/
__pycache__/
*.py[cod]
/.workbuddy/
# Rust executable entry points are source files, not compiled bin outputs.
!apps/diagram-renderer/src/bin/
!apps/diagram-renderer/src/bin/*.rs
!third_party/gifski/src/bin/
!third_party/gifski/src/bin/*.rs
# Agent entry point is AGENTS.md; CLAUDE.md is a local tool copy and must not drift.
/CLAUDE.md
# Keep this final: ignore _temp at every depth, after all negation rules.
/apps/desktop/frontend/public/pdfjs/
_temp/
